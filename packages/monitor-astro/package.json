{
  "name": "@accessible-so/monitor-astro",
  "version": "0.1.0",
  "description": "Astro integration for Accessible RUM: adds the loader to every page and reports route patterns from Astro's own route table.",
  "license": "MIT",
  "author": "Accessible <support@accessible.so>",
  "homepage": "https://accessible.so",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/accessible-so/accessible-monitor.git",
    "directory": "packages/monitor-astro"
  },
  "bugs": "https://github.com/accessible-so/accessible-monitor/issues",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "astro": ">=5 <8"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run && pnpm size",
    "size": "size-limit",
    "typecheck": "tsc --noEmit",
    "test:browser": "pnpm build && vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@accessible-so/monitor-core": "workspace:^"
  },
  "devDependencies": {
    "@size-limit/file": "^11.1.6",
    "@types/node": "^22.10.0",
    "astro": "7.3.6",
    "jsdom": "^25.0.1",
    "playwright": "^1.53.2",
    "size-limit": "^11.1.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "size-limit": [
    {
      "path": "dist/client.js",
      "limit": "1 KB",
      "gzip": true
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
